# Copy to .env (gitignored) and fill in. Nothing here is required to run the core in text mode.

# Front desk (latency-critical voice replies) and recording runs. Claude API key from the console.
# When unset, the front desk falls back to text mode and heavy work runs on local Claude Code.
ANTHROPIC_API_KEY=

# Where heavy thinking + code writing run: "claude-code" (local Claude Code login, default)
# or "api" (uses ANTHROPIC_API_KEY, e.g. when recording timings).
BARNABY_WORKER_BACKEND=claude-code
BARNABY_WORKER_MODEL=claude-opus-5-5
BARNABY_FRONT_DESK_MODEL=claude-haiku-5-5

# Bring-your-own-model backend (Pydantic AI model string), e.g. "openai:gpt-6.1-sol" or "ollama:qwen3".
BARNABY_BYOM_MODEL=

# Listening layer: sherpa | whisper | groq
BARNABY_LISTEN=sherpa
SHERPA_WS_URL=ws://192.168.1.68:6007
GROQ_API_KEY=

# Voice layer: kokoro | qwen
BARNABY_VOICE=kokoro
