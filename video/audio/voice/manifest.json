[
 {
  "t": 17.5,
  "who": "Theo",
  "text": "Barnaby, this is the shop's system. Look after them for me.",
  "file": "voice/01_Theo.wav",
  "dur": 4.27,
  "src": "tts"
 },
 {
  "t": 24.5,
  "who": "Barnaby",
  "text": "Twenty-three endpoints, sir. I've started with the six that only read.",
  "file": "voice/02_Barnaby.wav",
  "dur": 5.35,
  "src": "tts"
 },
 {
  "t": 28.5,
  "who": "Martin",
  "text": "Which repairs are due tomorrow, and are we short on parts?",
  "file": "voice/03_Martin.wav",
  "dur": 3.67,
  "src": "tts"
 },
 {
  "t": 34.0,
  "who": "Barnaby",
  "text": "Five are due tomorrow. Only one is short: Anika's brake job needs two pairs of pads, and we have one.",
  "file": "voice/04_Barnaby.wav",
  "dur": 7.7,
  "src": "tts"
 },
 {
  "t": 42.5,
  "who": "Martin",
  "text": "Order ten pairs, from the usual supplier.",
  "file": "voice/05_Martin.wav",
  "dur": 3.03,
  "src": "tts"
 },
 {
  "t": 45.0,
  "who": "Barnaby",
  "text": "I can't yet, but the system can. There's an ordering endpoint I haven't taken. May I?",
  "file": "voice/06_Barnaby.wav",
  "dur": 7.53,
  "src": "tts"
 },
 {
  "t": 53.6,
  "who": "Martin",
  "text": "Yes.",
  "file": "voice/07_Martin.wav",
  "dur": 0.87,
  "src": "tts"
 },
 {
  "t": 61.5,
  "who": "Barnaby",
  "text": "You've had me do these four steps four times today. Shall I make it a single motion?",
  "file": "voice/08_Barnaby.wav",
  "dur": 5.99,
  "src": "tts"
 },
 {
  "t": 70.5,
  "who": "Martin",
  "text": "Who's overloaded this week?",
  "file": "voice/09_Martin.wav",
  "dur": 2.3,
  "src": "tts"
 },
 {
  "t": 72.0,
  "who": "Barnaby",
  "text": "The system has no notion of workload, sir. I can teach it.",
  "file": "voice/10_Barnaby.wav",
  "dur": 4.97,
  "src": "tts"
 },
 {
  "t": 91.0,
  "who": "Barnaby",
  "text": "Dev has thirty-one hours booked against twenty. Shall I move the two wheel builds to Priya?",
  "file": "voice/11_Barnaby.wav",
  "dur": 6.8,
  "src": "tts"
 },
 {
  "t": 97.6,
  "who": "Martin",
  "text": "Yes, please.",
  "file": "voice/12_Martin.wav",
  "dur": 1.58,
  "src": "tts"
 },
 {
  "t": 102.5,
  "who": "Priya",
  "text": "What can this system actually do?",
  "file": "voice/13_Priya.wav",
  "dur": 2.22,
  "src": "tts"
 },
 {
  "t": 105.0,
  "who": "Barnaby",
  "text": "Twenty-four things. Theo wrote twenty-three; I wrote one more.",
  "file": "voice/14_Barnaby.wav",
  "dur": 5.03,
  "src": "tts"
 },
 {
  "t": 129.5,
  "who": "Barnaby",
  "text": "Every system deserves a butler.",
  "file": "voice/15_Barnaby.wav",
  "dur": 2.67,
  "src": "tts"
 },
 {
  "t": 132.0,
  "who": "Barnaby",
  "text": "Even the old ones.",
  "file": "voice/16_Barnaby.wav",
  "dur": 1.73,
  "src": "tts"
 }
]