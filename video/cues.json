  "captions": [
    [4.5, 10.5, "Every small business runs on systems nobody has time to rewrite."],
    [12.0, 16.8, "Theo wrote the shop's back office in 2009. On Friday, he leaves."],
    [66.0, 68.6, "Unlock: Synapse had already found it. Barnaby asked, then took it."],
    [79.2, 81.8, "Compose: one verified skill instead of four steps."],
    [116.6, 119.8, "Build: the report Theo never wrote. Tested, approved, live."],
    [128.4, 130.8, "The departing expert's knowledge, kept."],
    [131.5, 137.5, "Point Barnaby at any repo."],
    [138.0, 145.5, "Synapse makes it agent-ready. Barnaby makes it grow."]
  ],
  "voice": [
    {"t": 17.3, "who": "Theo", "text": "Barnaby, this is the shop's system. Look after them for me."},
    {"t": 24.3, "who": "Barnaby", "text": "Twenty-three endpoints, sir. I've started with the six that only read."},
    {"t": 31.2, "who": "Martin", "text": "Which repairs are due tomorrow, and are we short on parts?"},
    {"t": 38.6, "who": "Barnaby", "text": "Five are due tomorrow. Only one is short: Anika's brake job needs two pairs of pads, and we have one."},
    {"t": 47.6, "who": "Martin", "text": "Order ten pairs, from the usual supplier."},
    {"t": 51.2, "who": "Barnaby", "text": "I can't yet, but the system can. There's an ordering endpoint I haven't taken. May I?"},
    {"t": 64.0, "who": "Martin", "text": "Yes."},
    {"t": 72.4, "who": "Barnaby", "text": "You've had me do these four steps four times today. Shall I make it a single motion?"},
    {"t": 82.6, "who": "Martin", "text": "Who's overloaded this week?"},
    {"t": 85.2, "who": "Barnaby", "text": "The system has no notion of workload, sir. I can teach it."},
    {"t": 107.3, "who": "Barnaby", "text": "Dev has thirty-one hours booked against twenty. Shall I move the two wheel builds to Priya?"},
    {"t": 114.5, "who": "Martin", "text": "Yes, please."},
    {"t": 120.6, "who": "Priya", "text": "What can this system actually do?"},
    {"t": 123.2, "who": "Barnaby", "text": "Twenty-four things. Theo wrote twenty-three; I wrote one more."},
    {"t": 148.5, "who": "Barnaby", "text": "Every system deserves a butler."},
    {"t": 151.6, "who": "Barnaby", "text": "Even the old ones."}
  ],
