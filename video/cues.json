  "captions": [
    [4.5, 10.5, "Every small business runs on systems nobody has time to rewrite."],
    [12.0, 16.8, "Theo wrote the shop's back office in 2009. On Friday, he leaves."],
    [55.5, 57.8, "Unlock: Synapse had already found it. Barnaby asked, then took it."],
    [67.2, 69.8, "Compose: one verified skill instead of four steps."],
    [98.5, 101.8, "Build: the report Theo never wrote. Tested, approved, live."],
    [109.2, 111.8, "The departing expert's knowledge, kept."],
    [112.5, 118.5, "Point Barnaby at any repo."],
    [119.0, 126.5, "Synapse makes it agent-ready. Barnaby makes it grow."]
  ],
  "voice": [
    {"t": 17.5, "who": "Theo", "text": "Barnaby, this is the shop's system. Look after them for me."},
    {"t": 24.5, "who": "Barnaby", "text": "Twenty-three endpoints, sir. I've started with the six that only read."},
    {"t": 28.5, "who": "June", "text": "Which repairs are due tomorrow, and are we short on parts?"},
    {"t": 34.0, "who": "Barnaby", "text": "Five are due tomorrow. Only one is short: Anika's brake job needs two pairs of pads, and we have one."},
    {"t": 42.5, "who": "June", "text": "Order ten pairs, from the usual supplier."},
    {"t": 45.0, "who": "Barnaby", "text": "I can't yet, but the system can. There's an ordering endpoint I haven't taken. May I?"},
    {"t": 53.6, "who": "June", "text": "Yes."},
    {"t": 61.5, "who": "Barnaby", "text": "You've had me do these four steps four times today. Shall I make it a single motion?"},
    {"t": 70.5, "who": "June", "text": "Who's overloaded this week?"},
    {"t": 72.0, "who": "Barnaby", "text": "The system has no notion of workload, ma'am. I can teach it."},
    {"t": 91.0, "who": "Barnaby", "text": "Dev has thirty-one hours booked against twenty. Shall I move the two wheel builds to Priya?"},
    {"t": 97.6, "who": "June", "text": "Yes, please."},
    {"t": 102.5, "who": "Priya", "text": "What can this system actually do?"},
    {"t": 105.0, "who": "Barnaby", "text": "Twenty-four things. Theo wrote twenty-three; I wrote one more."},
    {"t": 129.5, "who": "Barnaby", "text": "Every system deserves a butler."},
    {"t": 132.0, "who": "Barnaby", "text": "Even the old ones."}
  ],
