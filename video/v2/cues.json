 "voice": [
  {
   "t": 5.17,
   "scene": 1,
   "who": "Martin",
   "pace": "tired",
   "text": "Theo — where's the parts list again?",
   "speech": [
    5.2,
    7.38
   ]
  },
  {
   "t": 7.63,
   "scene": 1,
   "who": "Theo",
   "pace": "brisk",
   "text": "Tab four. No — five.",
   "speech": [
    7.68,
    8.8
   ]
  },
  {
   "t": 9.31,
   "scene": 1,
   "who": "Theo",
   "pace": "neutral",
   "text": "It's the one with the spanner.",
   "speech": [
    9.35,
    11.1
   ]
  },
  {
   "t": 14.27,
   "scene": 2,
   "who": "Theo",
   "pace": "wistful",
   "text": "Seventeen years.",
   "speech": [
    14.3,
    15.25
   ]
  },
  {
   "t": 19.01,
   "scene": 2,
   "who": "Theo",
   "pace": "wistful",
   "text": "Right. Barnaby — this is the shop's system. I wrote it when I was fourteen, so be kind. Look after them for me.",
   "speech": [
    19.05,
    26.34
   ]
  },
  {
   "t": 26.61,
   "scene": 2,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "Twenty-three endpoints, sir. I've taken the six that only read — nobody's given me any keys yet.",
   "speech": [
    26.64,
    32.92
   ]
  },
  {
   "t": 33.18,
   "scene": 2,
   "who": "Theo",
   "pace": "dry",
   "text": "It's Theo. And don't call my uncle sir — he'll unplug you.",
   "speech": [
    33.22,
    36.8
   ]
  },
  {
   "t": 37.08,
   "scene": 2,
   "who": "Barnaby",
   "pace": "dry",
   "text": "Noted.",
   "speech": [
    37.1,
    37.79
   ]
  },
  {
   "t": 43.39,
   "scene": 3,
   "who": "Martin",
   "pace": "tired",
   "text": "Right. Barnaby, is it?",
   "speech": [
    43.44,
    45.15
   ]
  },
  {
   "t": 45.43,
   "scene": 3,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "Good morning, Martin.",
   "speech": [
    45.45,
    46.87
   ]
  },
  {
   "t": 47.11,
   "scene": 3,
   "who": "Martin",
   "pace": "brisk",
   "text": "What's due tomorrow — and are we short on anything?",
   "speech": [
    47.17,
    50.19
   ]
  },
  {
   "t": 50.71,
   "scene": 3,
   "who": "Barnaby",
   "pace": "explain",
   "text": "Five bikes due tomorrow. Only Anika's is a problem — her brakes need two pairs of pads, and we've one left.",
   "speech": [
    50.74,
    58.11
   ]
  },
  {
   "t": 58.82,
   "scene": 4,
   "who": "Martin",
   "pace": "brisk",
   "text": "Order ten from Madison, then.",
   "speech": [
    58.86,
    60.64
   ]
  },
  {
   "t": 60.91,
   "scene": 4,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "I can't order parts myself yet — but Theo built the system a way to. Shall I take that on?",
   "speech": [
    60.94,
    67.33
   ]
  },
  {
   "t": 67.59,
   "scene": 4,
   "who": "Martin",
   "pace": "neutral",
   "text": "Go on, then.",
   "speech": [
    67.63,
    68.67
   ]
  },
  {
   "t": 70.74,
   "scene": 4,
   "who": "Barnaby",
   "pace": "explain",
   "text": "Ten pairs from Madison, at six pounds fifty a pair. Shall I?",
   "speech": [
    70.77,
    75.19
   ]
  },
  {
   "t": 75.37,
   "scene": 4,
   "who": "Martin",
   "pace": "neutral",
   "text": "Yes.",
   "speech": [
    75.41,
    75.85
   ]
  },
  {
   "t": 78.89,
   "scene": 5,
   "who": "Martin",
   "pace": "brisk",
   "text": "Barnaby — Sofia's bike's done.",
   "speech": [
    78.92,
    80.49
   ]
  },
  {
   "t": 80.76,
   "scene": 5,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "I'll need to text her and mark it ready. May I?",
   "speech": [
    80.79,
    84.32
   ]
  },
  {
   "t": 84.49,
   "scene": 5,
   "who": "Martin",
   "pace": "brisk",
   "text": "Go on.",
   "speech": [
    84.54,
    85.26
   ]
  },
  {
   "t": 87.36,
   "scene": 5,
   "who": "Martin",
   "pace": "brisk",
   "text": "Kwame's.",
   "speech": [
    87.41,
    87.93
   ]
  },
  {
   "t": 89.16,
   "scene": 5,
   "who": "Martin",
   "pace": "brisk",
   "text": "And Jana's.",
   "speech": [
    89.21,
    90.1
   ]
  },
  {
   "t": 90.36,
   "scene": 5,
   "who": "Barnaby",
   "pace": "dry",
   "text": "That's three bikes handed back, and the same four steps each time. Shall I make it one?",
   "speech": [
    90.4,
    96.08
   ]
  },
  {
   "t": 96.26,
   "scene": 5,
   "who": "Martin",
   "pace": "surprised",
   "text": "Can you?",
   "speech": [
    96.3,
    97.0
   ]
  },
  {
   "t": 97.28,
   "scene": 5,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "Give me a moment.",
   "speech": [
    97.3,
    98.81
   ]
  },
  {
   "t": 100.52,
   "scene": 5,
   "who": "Martin",
   "pace": "neutral",
   "text": "Tom's Brompton.",
   "speech": [
    100.56,
    101.52
   ]
  },
  {
   "t": 101.79,
   "scene": 5,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "Tom's been texted, and it's marked ready.",
   "speech": [
    101.82,
    104.28
   ]
  },
  {
   "t": 105.09,
   "scene": 6,
   "who": "Martin",
   "pace": "neutral",
   "text": "Who's got too much on this week?",
   "speech": [
    105.13,
    107.2
   ]
  },
  {
   "t": 107.46,
   "scene": 6,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "The system can't tell me — there's no report for it. Theo always meant to write one.",
   "speech": [
    107.5,
    112.94
   ]
  },
  {
   "t": 113.37,
   "scene": 6,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "I could write it, if you like.",
   "speech": [
    113.39,
    115.53
   ]
  },
  {
   "t": 115.78,
   "scene": 6,
   "who": "Martin",
   "pace": "surprised",
   "text": "You can do that?",
   "speech": [
    115.83,
    117.03
   ]
  },
  {
   "t": 117.3,
   "scene": 6,
   "who": "Barnaby",
   "pace": "explain",
   "text": "With your say-so. I'll work on a copy — nothing changes until you've seen it.",
   "speech": [
    117.33,
    122.82
   ]
  },
  {
   "t": 125.89,
   "scene": 6,
   "who": "Barnaby",
   "pace": "explain",
   "text": "Done. It adds up each mechanic's hours for the week, the way Theo's notes count them. It only reads — it can't change a thing — and all of Theo's checks still pass. Shall I add it?",
   "speech": [
    125.92,
    138.23
   ]
  },
  {
   "t": 138.5,
   "scene": 6,
   "who": "Martin",
   "pace": "neutral",
   "text": "Add it.",
   "speech": [
    138.53,
    139.29
   ]
  },
  {
   "t": 139.56,
   "scene": 6,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "That one needs your click, Martin. I don't change the system on a word.",
   "speech": [
    139.59,
    144.21
   ]
  },
  {
   "t": 144.46,
   "scene": 6,
   "who": "Martin",
   "pace": "dry",
   "text": "Fussy.",
   "speech": [
    144.51,
    145.15
   ]
  },
  {
   "t": 148.12,
   "scene": 6,
   "who": "Barnaby",
   "pace": "explain",
   "text": "Dev's carrying thirty-one hours against his twenty. Priya starts tomorrow — shall I give her the two wheel builds?",
   "speech": [
    148.16,
    155.55
   ]
  },
  {
   "t": 155.8,
   "scene": 6,
   "who": "Martin",
   "pace": "neutral",
   "text": "Good idea.",
   "speech": [
    155.85,
    156.8
   ]
  },
  {
   "t": 160.26,
   "scene": 7,
   "who": "Priya",
   "pace": "dry",
   "text": "So you're why I've got two wheel builds on my first day?",
   "speech": [
    160.3,
    164.05
   ]
  },
  {
   "t": 164.33,
   "scene": 7,
   "who": "Barnaby",
   "pace": "dry",
   "text": "Guilty. Dev had thirty-one hours booked. You had none.",
   "speech": [
    164.35,
    168.01
   ]
  },
  {
   "t": 168.27,
   "scene": 7,
   "who": "Priya",
   "pace": "dry",
   "text": "Fair. What else can this thing do?",
   "speech": [
    168.31,
    170.36
   ]
  },
  {
   "t": 170.62,
   "scene": 7,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "Your jobs, the parts they need, who's collecting what. And Theo left you a note: never trust the stock count on a Friday.",
   "speech": [
    170.66,
    178.45
   ]
  },
  {
   "t": 178.71,
   "scene": 7,
   "who": "Priya",
   "pace": "dry",
   "text": "Noted.",
   "speech": [
    178.75,
    179.36
   ]
  },
  {
   "t": 185.24,
   "scene": 8,
   "who": "Theo",
   "pace": "neutral",
   "text": "Barnaby — new job. This is the crew's memory.",
   "speech": [
    185.26,
    187.9
   ]
  },
  {
   "t": 188.15,
   "scene": 8,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "Thirteen endpoints, sir — and two deadlines in dispute. Shall I flag them?",
   "speech": [
    188.2,
    192.51
   ]
  },
  {
   "t": 192.78,
   "scene": 8,
   "who": "Theo",
   "pace": "dry",
   "text": "Still Theo.",
   "speech": [
    192.81,
    193.71
   ]
  },
  {
   "t": 193.98,
   "scene": 8,
   "who": "Barnaby",
   "pace": "dry",
   "text": "Theo.",
   "speech": [
    194.01,
    194.68
   ]
  },
  {
   "t": 194.96,
   "scene": 8,
   "who": "Theo",
   "pace": "neutral",
   "text": "And the render box?",
   "speech": [
    194.98,
    196.29
   ]
  },
  {
   "t": 196.56,
   "scene": 8,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "Twenty-eight endpoints. It's on the big card, and three jobs are queued.",
   "speech": [
    196.59,
    200.98
   ]
  },
  {
   "t": 201.26,
   "scene": 8,
   "who": "Theo",
   "pace": "dry",
   "text": "Show-off.",
   "speech": [
    201.28,
    202.04
   ]
  },
  {
   "t": 203.65,
   "scene": 9,
   "who": "Martin",
   "pace": "closing",
   "text": "Night, Barnaby.",
   "speech": [
    203.69,
    204.92
   ]
  },
  {
   "t": 205.18,
   "scene": 9,
   "who": "Barnaby",
   "pace": "closing",
   "text": "Goodnight, Martin.",
   "speech": [
