 "voice": [
  {
   "t": 21.2,
   "scene": 1,
   "who": "Martin",
   "pace": "tired",
   "text": "Theo — where's the parts list again?",
   "speech": [
    21.2,
    24.03
   ]
  },
  {
   "t": 24.41,
   "scene": 1,
   "who": "Theo",
   "pace": "brisk",
   "text": "Tab four. No — five.",
   "speech": [
    24.73,
    26.36
   ]
  },
  {
   "t": 26.49,
   "scene": 1,
   "who": "Theo",
   "pace": "neutral",
   "text": "It's the one with the spanner.",
   "speech": [
    27.26,
    28.64
   ]
  },
  {
   "t": 36.87,
   "scene": 2,
   "who": "Theo",
   "pace": "wistful",
   "text": "Ah… seventeen years.",
   "speech": [
    37.04,
    39.42
   ]
  },
  {
   "t": 48.83,
   "scene": 2,
   "who": "Theo",
   "pace": "wistful",
   "text": "Right. Barnaby — this is the shop's system. I wrote it when I was fourteen, so be kind. Look after them for me.",
   "speech": [
    48.92,
    56.98
   ]
  },
  {
   "t": 57.95,
   "scene": 2,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "Twenty-three endpoints, sir. I've taken the six that only read — nobody's given me any keys yet.",
   "speech": [
    57.98,
    63.66
   ]
  },
  {
   "t": 63.71,
   "scene": 2,
   "who": "Theo",
   "pace": "dry",
   "text": "It's Theo. And don't call my uncle sir — he'll unplug you.",
   "speech": [
    64.11,
    68.27
   ]
  },
  {
   "t": 68.72,
   "scene": 2,
   "who": "Barnaby",
   "pace": "dry",
   "text": "Noted.",
   "speech": [
    68.87,
    69.98
   ]
  },
  {
   "t": 81.01,
   "scene": 3,
   "who": "Martin",
   "pace": "tired",
   "text": "Right. Barnaby, is it?",
   "speech": [
    81.38,
    83.5
   ]
  },
  {
   "t": 83.9,
   "scene": 3,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "Good morning, Martin.",
   "speech": [
    83.95,
    84.95
   ]
  },
  {
   "t": 85.31,
   "scene": 3,
   "who": "Martin",
   "pace": "brisk",
   "text": "Can you tell me what's due tomorrow — and are we short on anything?",
   "speech": [
    85.55,
    89.16
   ]
  },
  {
   "t": 89.92,
   "scene": 3,
   "who": "Barnaby",
   "pace": "explain",
   "text": "Five bikes due tomorrow. Only Anika's is a problem — her brakes need two pairs of pads, and we've one left.",
   "speech": [
    90.06,
    96.75
   ]
  },
  {
   "t": 98.25,
   "scene": 4,
   "who": "Martin",
   "pace": "brisk",
   "text": "Alright, order ten from Madison, then.",
   "speech": [
    98.55,
    100.61
   ]
  },
  {
   "t": 101.05,
   "scene": 4,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "I can't order parts myself yet — but Theo built the system a way to. Shall I take that on?",
   "speech": [
    101.06,
    106.93
   ]
  },
  {
   "t": 107.34,
   "scene": 4,
   "who": "Martin",
   "pace": "neutral",
   "text": "Go right ahead.",
   "speech": [
    107.73,
    108.6
   ]
  },
  {
   "t": 111.53,
   "scene": 4,
   "who": "Barnaby",
   "pace": "explain",
   "text": "Ten pairs from Madison, at six pounds fifty a pair. Shall I?",
   "speech": [
    111.8,
    115.67
   ]
  },
  {
   "t": 115.77,
   "scene": 4,
   "who": "Martin",
   "pace": "neutral",
   "text": "Yes.",
   "speech": [
    116.07,
    117.06
   ]
  },
  {
   "t": 122.35,
   "scene": 5,
   "who": "Martin",
   "pace": "brisk",
   "text": "Barnaby — Sofia's bike's done.",
   "speech": [
    122.66,
    124.38
   ]
  },
  {
   "t": 124.78,
   "scene": 5,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "I'll need to text her and mark it ready. May I?",
   "speech": [
    124.83,
    128.25
   ]
  },
  {
   "t": 128.6,
   "scene": 5,
   "who": "Martin",
   "pace": "brisk",
   "text": "Go on.",
   "speech": [
    128.75,
    129.64
   ]
  },
  {
   "t": 132.82,
   "scene": 5,
   "who": "Martin",
   "pace": "brisk",
   "text": "Kwame's.",
   "speech": [
    132.99,
    133.6
   ]
  },
  {
   "t": 135.7,
   "scene": 5,
   "who": "Martin",
   "pace": "brisk",
   "text": "And Jana's.",
   "speech": [
    135.7,
    137.59
   ]
  },
  {
   "t": 138.31,
   "scene": 5,
   "who": "Barnaby",
   "pace": "dry",
   "text": "That's three bikes handed back, and the same four steps each time. Shall I make it one?",
   "speech": [
    138.49,
    143.88
   ]
  },
  {
   "t": 144.0,
   "scene": 5,
   "who": "Martin",
   "pace": "surprised",
   "text": "Can you?",
   "speech": [
    144.28,
    145.56
   ]
  },
  {
   "t": 145.8,
   "scene": 5,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "Give me a moment.",
   "speech": [
    146.01,
    147.17
   ]
  },
  {
   "t": 149.73,
   "scene": 5,
   "who": "Martin",
   "pace": "neutral",
   "text": "Tom's Brompton.",
   "speech": [
    150.12,
    151.45
   ]
  },
  {
   "t": 151.92,
   "scene": 5,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "Tom's been texted, and it's marked ready.",
   "speech": [
    152.05,
    154.34
   ]
  },
  {
   "t": 157.5,
   "scene": 6,
   "who": "Martin",
   "pace": "neutral",
   "text": "Okay, who's got too much on this week?",
   "speech": [
    157.54,
    160.22
   ]
  },
  {
   "t": 160.8,
   "scene": 6,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "The system can't tell me — there's no report for it. Theo always meant to write one.",
   "speech": [
    160.82,
    166.25
   ]
  },
  {
   "t": 166.76,
   "scene": 6,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "I could write it, if you like.",
   "speech": [
    166.95,
    168.78
   ]
  },
  {
   "t": 169.16,
   "scene": 6,
   "who": "Martin",
   "pace": "surprised",
   "text": "You can do that?",
   "speech": [
    169.23,
    171.04
   ]
  },
  {
   "t": 171.36,
   "scene": 6,
   "who": "Barnaby",
   "pace": "explain",
   "text": "With your say-so. I'll work on a copy — nothing changes until you've seen it.",
   "speech": [
    171.49,
    176.18
   ]
  },
  {
   "t": 183.06,
   "scene": 6,
   "who": "Barnaby",
   "pace": "explain",
   "text": "Done. It adds up each mechanic's hours, the way Theo's notes count them. It only reads, and all of Theo's checks still pass. Shall I add it?",
   "speech": [
    183.18,
    192.18
   ]
  },
  {
   "t": 192.5,
   "scene": 6,
   "who": "Martin",
   "pace": "neutral",
   "text": "Mm-hmm. Add it.",
   "speech": [
    192.63,
    193.65
   ]
  },
  {
   "t": 193.89,
   "scene": 6,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "That one needs your click, Martin. I don't change the system on a word.",
   "speech": [
    194.1,
    198.46
   ]
  },
  {
   "t": 198.73,
   "scene": 6,
   "who": "Martin",
   "pace": "dry",
   "text": "Ah… fussy.",
   "speech": [
    199.06,
    200.03
   ]
  },
  {
   "t": 204.38,
   "scene": 6,
   "who": "Barnaby",
   "pace": "explain",
   "text": "Dev's carrying thirty-one hours against his twenty. Priya starts tomorrow — shall I give her the two wheel builds?",
   "speech": [
    204.63,
    210.97
   ]
  },
  {
   "t": 211.11,
   "scene": 6,
   "who": "Martin",
   "pace": "neutral",
   "text": "Good idea.",
   "speech": [
    211.57,
    212.17
   ]
  },
  {
   "t": 219.35,
   "scene": 7,
   "who": "Priya",
   "pace": "dry",
   "text": "So you're why I've got two wheel builds on my first day?",
   "speech": [
    219.57,
    223.53
   ]
  },
  {
   "t": 223.96,
   "scene": 7,
   "who": "Barnaby",
   "pace": "dry",
   "text": "Guilty. Dev had thirty-one hours booked. You had none.",
   "speech": [
    224.13,
    228.31
   ]
  },
  {
   "t": 228.59,
   "scene": 7,
   "who": "Priya",
   "pace": "dry",
   "text": "Fair. What else can this thing do?",
   "speech": [
    228.91,
    231.75
   ]
  },
  {
   "t": 232.09,
   "scene": 7,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "Your jobs, the parts they need, who's collecting what. And Theo left you a note: never trust the stock count on a Friday.",
   "speech": [
    232.2,
    239.78
   ]
  },
  {
   "t": 240.25,
   "scene": 7,
   "who": "Priya",
   "pace": "dry",
   "text": "Noted.",
   "speech": [
    240.58,
    241.74
   ]
  },
  {
   "t": 254.79,
   "scene": 8,
   "who": "Theo",
   "pace": "neutral",
   "text": "Barnaby — new job. This is the crew's memory.",
   "speech": [
    255.24,
    257.85
   ]
  },
  {
   "t": 259.03,
   "scene": 8,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "Thirteen endpoints, sir — and two deadlines in dispute. Shall I flag them?",
   "speech": [
    259.05,
    263.59
   ]
  },
  {
   "t": 263.72,
   "scene": 8,
   "who": "Theo",
   "pace": "dry",
   "text": "Still Theo.",
   "speech": [
    264.19,
    265.13
   ]
  },
  {
   "t": 265.46,
   "scene": 8,
   "who": "Barnaby",
   "pace": "dry",
   "text": "Theo.",
   "speech": [
    265.63,
    266.17
   ]
  },
  {
   "t": 267.07,
   "scene": 8,
   "who": "Theo",
   "pace": "neutral",
   "text": "And the render box?",
   "speech": [
    267.07,
    269.34
   ]
  },
  {
   "t": 269.57,
   "scene": 8,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "Twenty-eight endpoints. It's on the big card, and three jobs are queued.",
   "speech": [
    269.79,
    274.14
   ]
  },
  {
   "t": 274.43,
   "scene": 8,
   "who": "Theo",
   "pace": "dry",
   "text": "Show-off.",
   "speech": [
    274.84,
    275.67
   ]
  },
  {
   "t": 279.6,
   "scene": 9,
   "who": "Martin",
   "pace": "closing",
   "text": "Night, Barnaby.",
   "speech": [
    279.67,
    281.33
   ]
  },
  {
