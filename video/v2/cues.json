 "voice": [
  {
   "t": 21.16,
   "scene": 1,
   "who": "Martin",
   "pace": "tired",
   "text": "Theo — where's the parts list again?",
   "speech": [
    21.2,
    23.9
   ]
  },
  {
   "t": 24.57,
   "scene": 1,
   "who": "Theo",
   "pace": "brisk",
   "text": "Tab four. No — five.",
   "speech": [
    24.6,
    25.87
   ]
  },
  {
   "t": 26.73,
   "scene": 1,
   "who": "Theo",
   "pace": "neutral",
   "text": "It's the one with the spanner.",
   "speech": [
    26.77,
    28.78
   ]
  },
  {
   "t": 37.16,
   "scene": 2,
   "who": "Theo",
   "pace": "wistful",
   "text": "Seventeen years.",
   "speech": [
    37.18,
    38.25
   ]
  },
  {
   "t": 47.73,
   "scene": 2,
   "who": "Theo",
   "pace": "wistful",
   "text": "Right. Barnaby — this is the shop's system. I wrote it when I was fourteen, so be kind. Look after them for me.",
   "speech": [
    47.75,
    55.84
   ]
  },
  {
   "t": 56.79,
   "scene": 2,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "Twenty-three endpoints, sir. I've taken the six that only read — nobody's given me any keys yet.",
   "speech": [
    56.84,
    62.53
   ]
  },
  {
   "t": 62.94,
   "scene": 2,
   "who": "Theo",
   "pace": "dry",
   "text": "It's Theo. And don't call my uncle sir — he'll unplug you.",
   "speech": [
    62.98,
    66.96
   ]
  },
  {
   "t": 67.31,
   "scene": 2,
   "who": "Barnaby",
   "pace": "dry",
   "text": "Noted.",
   "speech": [
    67.56,
    68.22
   ]
  },
  {
   "t": 79.59,
   "scene": 3,
   "who": "Martin",
   "pace": "tired",
   "text": "Right. Barnaby, is it?",
   "speech": [
    79.62,
    81.69
   ]
  },
  {
   "t": 81.98,
   "scene": 3,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "Good morning, Martin.",
   "speech": [
    82.14,
    83.07
   ]
  },
  {
   "t": 83.63,
   "scene": 3,
   "who": "Martin",
   "pace": "brisk",
   "text": "What's due tomorrow — and are we short on anything?",
   "speech": [
    83.67,
    87.32
   ]
  },
  {
   "t": 88.21,
   "scene": 3,
   "who": "Barnaby",
   "pace": "explain",
   "text": "Five bikes due tomorrow. Only Anika's is a problem — her brakes need two pairs of pads, and we've one left.",
   "speech": [
    88.22,
    95.55
   ]
  },
  {
   "t": 97.3,
   "scene": 4,
   "who": "Martin",
   "pace": "brisk",
   "text": "Order ten from Madison, then.",
   "speech": [
    97.35,
    99.47
   ]
  },
  {
   "t": 99.87,
   "scene": 4,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "I can't order parts myself yet — but Theo built the system a way to. Shall I take that on?",
   "speech": [
    99.92,
    105.95
   ]
  },
  {
   "t": 106.72,
   "scene": 4,
   "who": "Martin",
   "pace": "neutral",
   "text": "Go on, then.",
   "speech": [
    106.75,
    108.0
   ]
  },
  {
   "t": 111.15,
   "scene": 4,
   "who": "Barnaby",
   "pace": "explain",
   "text": "Ten pairs from Madison, at six pounds fifty a pair. Shall I?",
   "speech": [
    111.2,
    115.29
   ]
  },
  {
   "t": 115.66,
   "scene": 4,
   "who": "Martin",
   "pace": "neutral",
   "text": "Yes.",
   "speech": [
    115.69,
    116.22
   ]
  },
  {
   "t": 121.79,
   "scene": 5,
   "who": "Martin",
   "pace": "brisk",
   "text": "Barnaby — Sofia's bike's done.",
   "speech": [
    121.82,
    123.72
   ]
  },
  {
   "t": 124.13,
   "scene": 5,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "I'll need to text her and mark it ready. May I?",
   "speech": [
    124.17,
    127.49
   ]
  },
  {
   "t": 127.96,
   "scene": 5,
   "who": "Martin",
   "pace": "brisk",
   "text": "Go on.",
   "speech": [
    127.99,
    128.88
   ]
  },
  {
   "t": 132.18,
   "scene": 5,
   "who": "Martin",
   "pace": "brisk",
   "text": "Kwame's.",
   "speech": [
    132.23,
    132.75
   ]
  },
  {
   "t": 134.82,
   "scene": 5,
   "who": "Martin",
   "pace": "brisk",
   "text": "And Jana's.",
   "speech": [
    134.85,
    135.95
   ]
  },
  {
   "t": 136.77,
   "scene": 5,
   "who": "Barnaby",
   "pace": "dry",
   "text": "That's three bikes handed back, and the same four steps each time. Shall I make it one?",
   "speech": [
    136.85,
    142.55
   ]
  },
  {
   "t": 142.9,
   "scene": 5,
   "who": "Martin",
   "pace": "surprised",
   "text": "Can you?",
   "speech": [
    142.95,
    143.82
   ]
  },
  {
   "t": 144.21,
   "scene": 5,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "Give me a moment.",
   "speech": [
    144.27,
    145.05
   ]
  },
  {
   "t": 147.97,
   "scene": 5,
   "who": "Martin",
   "pace": "neutral",
   "text": "Tom's Brompton.",
   "speech": [
    148.0,
    149.14
   ]
  },
  {
   "t": 149.67,
   "scene": 5,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "Tom's been texted, and it's marked ready.",
   "speech": [
    149.74,
    152.07
   ]
  },
  {
   "t": 155.23,
   "scene": 6,
   "who": "Martin",
   "pace": "neutral",
   "text": "Who's got too much on this week?",
   "speech": [
    155.27,
    157.76
   ]
  },
  {
   "t": 158.28,
   "scene": 6,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "The system can't tell me — there's no report for it. Theo always meant to write one.",
   "speech": [
    158.36,
    163.66
   ]
  },
  {
   "t": 164.25,
   "scene": 6,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "I could write it, if you like.",
   "speech": [
    164.36,
    166.73
   ]
  },
  {
   "t": 167.15,
   "scene": 6,
   "who": "Martin",
   "pace": "surprised",
   "text": "You can do that?",
   "speech": [
    167.18,
    168.58
   ]
  },
  {
   "t": 168.96,
   "scene": 6,
   "who": "Barnaby",
   "pace": "explain",
   "text": "With your say-so. I'll work on a copy — nothing changes until you've seen it.",
   "speech": [
    169.03,
    174.05
   ]
  },
  {
   "t": 181.02,
   "scene": 6,
   "who": "Barnaby",
   "pace": "explain",
   "text": "Done. It adds up each mechanic's hours, the way Theo's notes count them. It only reads, and all of Theo's checks still pass. Shall I add it?",
   "speech": [
    181.05,
    190.77
   ]
  },
  {
   "t": 191.18,
   "scene": 6,
   "who": "Martin",
   "pace": "neutral",
   "text": "Add it.",
   "speech": [
    191.22,
    192.15
   ]
  },
  {
   "t": 192.52,
   "scene": 6,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "That one needs your click, Martin. I don't change the system on a word.",
   "speech": [
    192.6,
    197.24
   ]
  },
  {
   "t": 197.81,
   "scene": 6,
   "who": "Martin",
   "pace": "dry",
   "text": "Fussy.",
   "speech": [
    197.84,
    198.63
   ]
  },
  {
   "t": 203.09,
   "scene": 6,
   "who": "Barnaby",
   "pace": "explain",
   "text": "Dev's carrying thirty-one hours against his twenty. Priya starts tomorrow — shall I give her the two wheel builds?",
   "speech": [
    203.14,
    209.79
   ]
  },
  {
   "t": 210.35,
   "scene": 6,
   "who": "Martin",
   "pace": "neutral",
   "text": "Good idea.",
   "speech": [
    210.39,
    211.56
   ]
  },
  {
   "t": 217.33,
   "scene": 7,
   "who": "Priya",
   "pace": "dry",
   "text": "So you're why I've got two wheel builds on my first day?",
   "speech": [
    217.36,
    221.38
   ]
  },
  {
   "t": 221.9,
   "scene": 7,
   "who": "Barnaby",
   "pace": "dry",
   "text": "Guilty. Dev had thirty-one hours booked. You had none.",
   "speech": [
    221.98,
    225.76
   ]
  },
  {
   "t": 226.33,
   "scene": 7,
   "who": "Priya",
   "pace": "dry",
   "text": "Fair. What else can this thing do?",
   "speech": [
    226.36,
    228.7
   ]
  },
  {
   "t": 229.06,
   "scene": 7,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "Your jobs, the parts they need, who's collecting what. And Theo left you a note: never trust the stock count on a Friday.",
   "speech": [
    229.15,
    237.14
   ]
  },
  {
   "t": 237.91,
   "scene": 7,
   "who": "Priya",
   "pace": "dry",
   "text": "Noted.",
   "speech": [
    237.94,
    238.64
   ]
  },
  {
   "t": 252.1,
   "scene": 8,
   "who": "Theo",
   "pace": "neutral",
   "text": "Barnaby — new job. This is the crew's memory.",
   "speech": [
    252.14,
    255.18
   ]
  },
  {
   "t": 256.31,
   "scene": 8,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "Thirteen endpoints, sir — and two deadlines in dispute. Shall I flag them?",
   "speech": [
    256.38,
    260.53
   ]
  },
  {
   "t": 261.11,
   "scene": 8,
   "who": "Theo",
   "pace": "dry",
   "text": "Still Theo.",
   "speech": [
    261.13,
    262.16
   ]
  },
  {
   "t": 262.59,
   "scene": 8,
   "who": "Barnaby",
   "pace": "dry",
   "text": "Theo.",
   "speech": [
    262.66,
    263.23
   ]
  },
  {
   "t": 264.11,
   "scene": 8,
   "who": "Theo",
   "pace": "neutral",
   "text": "And the render box?",
   "speech": [
    264.13,
    265.63
   ]
  },
  {
   "t": 266.0,
   "scene": 8,
   "who": "Barnaby",
   "pace": "neutral",
   "text": "Twenty-eight endpoints. It's on the big card, and three jobs are queued.",
   "speech": [
    266.08,
    270.4
   ]
  },
  {
   "t": 271.08,
   "scene": 8,
   "who": "Theo",
   "pace": "dry",
   "text": "Show-off.",
   "speech": [
    271.1,
    271.97
   ]
  },
  {
   "t": 275.93,
   "scene": 9,
   "who": "Martin",
   "pace": "closing",
   "text": "Night, Barnaby.",
   "speech": [
    275.97,
    277.46
   ]
  },
  {
   "t": 277.99,
   "scene": 9,
   "who": "Barnaby",
   "pace": "closing",
   "text": "Goodnight, Martin.",
   "speech": [
    278.06,
